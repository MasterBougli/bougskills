{
  "name": "bougskills",
  "version": "1.3.4",
  "private": true,
  "description": "Outils portables sans dépendance pour valider et maintenir BougSkills",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "validate": "node scripts/verify_bougskills.mjs",
    "test": "node --test",
    "test:archive": "node tests/check_public_archive.mjs",
    "score": "node scripts/score_bougskills.mjs",
    "clean": "node scripts/clean_content.mjs",
    "update": "node scripts/check_bougskills_update.mjs",
    "update:offline": "node scripts/check_bougskills_update.mjs --skip-remote"
  }
}
